# Copy to backend/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase project settings -> API. The service-role key bypasses RLS: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed by CORS (Expo web dev server by default). Native apps send no Origin.
CORS_ORIGINS=http://localhost:8081

# ml-service (Hugging Face models live there; the HF token is NOT needed here).
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=change-me-shared-secret
ML_TIMEOUT_MS=8000

JOBS_ENABLED=true
JOBS_INTERVAL_MS=600000
