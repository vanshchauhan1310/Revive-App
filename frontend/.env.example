# Copy to frontend/.env. These values are bundled into the app, so only public keys go here.
# Backend URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to true after enabling the Google provider in Supabase Auth
EXPO_PUBLIC_GOOGLE_AUTH=false
