# Copy to ml-service/.env. Never commit the real file.
# Hugging Face access token (https://huggingface.co/settings/tokens) with
# "Make calls to Inference Providers" permission.
HF_API_TOKEN=hf_xxx
HF_PROVIDER=auto
# auto = hosted API, falling back to free local models (pip install -r requirements-local.txt)
# local = only local open models (no credits needed) · api = hosted only
HF_MODE=auto

# Must match ML_SERVICE_TOKEN in backend/.env
ML_SERVICE_TOKEN=change-me-shared-secret

# Optional model overrides
# VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# TOXICITY_MODEL=unitary/toxic-bert
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pipelines only: Supabase Postgres connection string (Project settings -> Database)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
